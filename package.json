{
    "name": "marco-polo",
    "version": "0.1.1",
    "private": true,
    "scripts": {
        "predev": "node scripts/generate-firebase-sw.js",
        "dev": "next dev",
        "prebuild": "node scripts/generate-firebase-sw.js",
        "build": "next build",
        "build:web": "next build --webpack",
        "clean:web": "rm -rf .next out",
        "clean:ios:web": "rm -rf ios/App/App/public",
        "sync:ios": "npm run clean:web && npm run clean:ios:web && npm run build:web && npx cap copy ios",
        "verify": "npm test && npx tsc --noEmit --pretty false --incremental false",
        "release:ios:prep": "npm run verify && npm run sync:ios",
        "start": "next start",
        "lint": "eslint",
        "test": "vitest run",
        "test:signals": "vitest run tests/haptics.test.ts tests/nativeNotifications.test.ts tests/signalFeedback.test.ts tests/friendCardVisuals.test.ts",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@capacitor-firebase/authentication": "^8.0.1",
        "@capacitor/cli": "^8.1.0",
        "@capacitor/core": "^8.1.0",
        "@capacitor/haptics": "^8.0.0",
        "@capacitor/ios": "^8.1.0",
        "@capacitor/local-notifications": "^8.0.1",
        "@capacitor/preferences": "^8.0.1",
        "@capacitor/push-notifications": "^8.0.1",
        "@capacitor/status-bar": "^8.0.1",
        "@capgo/capacitor-contacts": "^8.0.8",
        "clsx": "^2.1.1",
        "firebase": "^12.9.0",
        "firebase-admin": "^13.7.0",
        "lucide-react": "^0.563.0",
        "next": "16.1.6",
        "nodemailer": "^8.0.1",
        "qrcode.react": "^4.2.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-phone-number-input": "^3.4.14",
        "tailwind-merge": "^3.4.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/nodemailer": "^7.0.11",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.1.6",
        "playwright": "^1.58.2",
        "tailwindcss": "^4",
        "typescript": "^5",
        "vitest": "^4.1.2"
    }
}
